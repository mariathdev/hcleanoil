# Servidor
PORT=4000
NODE_ENV=development

# SMTP
# Gmail: use uma Senha de App (myaccount.google.com/apppasswords) — a senha
# normal da conta não funciona com 2FA ativa.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=contato.hcleanoil@gmail.com
SMTP_PASS=

# Remetente e destino
MAIL_FROM=contato.hcleanoil@gmail.com
MAIL_FROM_NAME=HCLEAN
MAIL_TO=contato.hcleanoil@gmail.com

# Envia e-mail de confirmação para quem preencheu o formulário
SEND_CONFIRMATION=true

# Origens liberadas no CORS (separadas por vírgula)
CORS_ORIGINS=http://localhost:3000,https://www.hcleanoil.com.br
